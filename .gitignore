# macOS
.DS_Store

# Xcode — per-user state, not project configuration.
# Note: xcshareddata/ is deliberately NOT ignored; it holds Package.resolved,
# which pins the exact dependency versions and belongs in the repo.
xcuserdata/
*.xcuserstate
DerivedData/
build/

# Supabase CLI local state: which project this machine is linked to, and
# cached server versions. Machine-specific, regenerated by `supabase link`.
supabase/.temp/

# Agent tooling that happens to live in the working directory.
.agents/
